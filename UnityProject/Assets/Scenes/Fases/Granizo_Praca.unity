  m_OpenButton: {fileID: 164742852}
  m_CloseButton: {fileID: 807750166}
  m_ReplyText: {fileID: 1394628215}
  m_Lines:
  - number: 199
    label: Defesa Civil
    reply: "Defesa Civil, obrigado pelo aviso. N\xE3o entre no quarto e n\xE3o suba
      no telhado. Uma equipe vai vistoriar a casa."
    button: {fileID: 1229368097}
  - number: 193
    label: Bombeiros
    reply: "Corpo de Bombeiros, ocorr\xEAncia registrada. Mantenha todos fora do
      quarto e longe do telhado."
    button: {fileID: 198145610}
  - number: 190
    label: "Pol\xEDcia Militar"
    reply: Vamos repassar, mas para risco de desabamento de telhado ligue para a
      Defesa Civil (199) ou para os Bombeiros (193).
    button: {fileID: 888220590}
  - number: 192
    label: SAMU
    reply: Vamos repassar, mas para risco de desabamento de telhado ligue para a
      Defesa Civil (199) ou para os Bombeiros (193).
    button: {fileID: 2136787590}
  m_AcceptedNumbers:
  - 199
  - 193
  m_OnAcceptedCall:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 827611032}
