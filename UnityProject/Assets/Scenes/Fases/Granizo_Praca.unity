  m_Root: {fileID: 1116440163}
  m_OpenButton: {fileID: 1639402616}
  m_NumberText: {fileID: 808594360}
  m_ReplyText: {fileID: 378651672}
  m_ClockText: {fileID: 1645941533}
  m_IdleText: "Digite o n\xFAmero e toque no bot\xE3o verde."
  m_MaxDigits: 12
  m_Lines:
  - number: 199
    label: Defesa Civil
    reply: "Defesa Civil, obrigado pelo aviso. N\xE3o entre no quarto e n\xE3o suba
      no telhado. Uma equipe vai vistoriar a casa."
  - number: 193
    label: Bombeiros
    reply: "Corpo de Bombeiros, ocorr\xEAncia registrada. Mantenha todos fora do
      quarto e longe do telhado."
  - number: 190
    label: "Pol\xEDcia Militar"
    reply: Vamos repassar, mas para risco de desabamento de telhado ligue para a
      Defesa Civil (199) ou para os Bombeiros (193).
  - number: 192
    label: SAMU
    reply: Vamos repassar, mas para risco de desabamento de telhado ligue para a
      Defesa Civil (199) ou para os Bombeiros (193).
  m_AcceptedNumbers:
  - 199
  - 193
  m_OnAcceptedCall:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1773635283}
