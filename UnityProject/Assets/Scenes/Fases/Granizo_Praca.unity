  m_Root: {fileID: 774367425}
  m_OpenButton: {fileID: 719337922}
  m_CloseButton: {fileID: 1958091727}
  m_ReplyText: {fileID: 1046046007}
  m_Lines:
  - number: 199
    label: Defesa Civil
    reply: "Defesa Civil, obrigado pelo aviso. N\xE3o entre no quarto e n\xE3o suba
      no telhado. Uma equipe vai vistoriar a casa."
    button: {fileID: 170113833}
  - number: 193
    label: Bombeiros
    reply: "Corpo de Bombeiros, ocorr\xEAncia registrada. Mantenha todos fora do
      quarto e longe do telhado."
    button: {fileID: 1376440987}
  - number: 190
    label: "Pol\xEDcia Militar"
    reply: Vamos repassar, mas para risco de desabamento de telhado ligue para a
      Defesa Civil (199) ou para os Bombeiros (193).
    button: {fileID: 1853419618}
  - number: 192
    label: SAMU
    reply: Vamos repassar, mas para risco de desabamento de telhado ligue para a
      Defesa Civil (199) ou para os Bombeiros (193).
    button: {fileID: 1599168165}
  m_AcceptedNumbers:
  - 199
  - 193
  m_OnAcceptedCall:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1236274053}
