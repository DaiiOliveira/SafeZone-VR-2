  m_EditorClassIdentifier: Assembly-CSharp::SafeZoneVR.EmergencyCallPanel
  m_Root: {fileID: 91613512}
  m_OpenButton: {fileID: 592639660}
  m_CloseButton: {fileID: 827118331}
  m_ReplyText: {fileID: 1019879477}
  m_Lines:
  - number: 199
    label: Defesa Civil
    reply: "Defesa Civil, obrigado pelo aviso. N\xE3o entre no quarto e n\xE3o suba
      no telhado. Uma equipe vai vistoriar a casa."
    button: {fileID: 2133805670}
  - number: 193
    label: Bombeiros
    reply: "Corpo de Bombeiros, ocorr\xEAncia registrada. Mantenha todos fora do
      quarto e longe do telhado."
    button: {fileID: 565816498}
  - number: 190
    label: "Pol\xEDcia Militar"
    reply: Vamos repassar, mas para risco de desabamento de telhado ligue para a
      Defesa Civil (199) ou para os Bombeiros (193).
    button: {fileID: 531864802}
  - number: 192
    label: SAMU
    reply: Vamos repassar, mas para risco de desabamento de telhado ligue para a
      Defesa Civil (199) ou para os Bombeiros (193).
    button: {fileID: 630797419}
  m_AcceptedNumbers:
  - 199
  - 193
  m_OnAcceptedCall:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1487670882}
        m_TargetAssemblyTypeName: SafeZoneVR.StepCompleteOnButtonPress, Assembly-CSharp
        m_MethodName: OnButtonPressed
