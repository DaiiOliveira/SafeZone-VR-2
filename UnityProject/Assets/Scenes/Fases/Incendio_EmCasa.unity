  m_Root: {fileID: 1906256990}
  m_OpenButton: {fileID: 1901943497}
  m_CloseButton: {fileID: 1033414926}
  m_ReplyText: {fileID: 979479947}
  m_Lines:
  - number: 199
    label: Defesa Civil
    reply: "Defesa Civil: vamos acionar os Bombeiros, mas em caso de inc\xEAndio
      ligue direto para o 193."
    button: {fileID: 994663465}
  - number: 193
    label: Bombeiros
    reply: "Corpo de Bombeiros. Endere\xE7o anotado, uma viatura est\xE1 a caminho.
      Todos sa\xEDram? N\xE3o entre na casa e mantenha as pessoas afastadas."
    button: {fileID: 1535768420}
  - number: 190
    label: "Pol\xEDcia Militar"
    reply: "Pol\xEDcia Militar: vamos repassar. Para inc\xEAndio, o n\xFAmero \xE9
      193."
    button: {fileID: 1847673221}
  - number: 192
    label: SAMU
    reply: "SAMU: se algu\xE9m estiver passando mal, estamos \xE0 disposi\xE7\xE3o.
      Para o inc\xEAndio, ligue 193."
    button: {fileID: 557035313}
  m_AcceptedNumbers:
  - 193
  m_OnAcceptedCall:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 429687765}
