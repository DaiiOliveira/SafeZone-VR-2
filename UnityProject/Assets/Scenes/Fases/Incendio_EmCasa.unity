  m_Script: {fileID: 11500000, guid: a150c566ba276264aa9baf6d02cda9fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SafeZoneVR.IntroBriefingPanel
  m_ScenarioManager: {fileID: 1878512263}
  m_Root: {fileID: 1161356715}
  m_TitleText: {fileID: 1120285068}
  m_BodyText: {fileID: 1989332648}
  m_StartButton: {fileID: 411704279}
  m_IntroText: "Fim de tarde. Voc\xEA esquentou \xF3leo para fritar e foi at\xE9
    a sala por um instante. Ao voltar, a panela <b>pegou fogo</b>. O fogo ainda \xE9
    pequeno: \xE9 um <b>princ\xEDpio de inc\xEAndio</b>.\nMantenha a calma. Fa\xE7a
    o que os Bombeiros orientam e, se o fogo sair do controle, saia de casa.\n\nO
    rel\xF3gio no pulso esquerdo mostra cada miss\xE3o e permite ligar para o 193.
    Aponte para o ch\xE3o e aperte o gatilho para se teleportar."
