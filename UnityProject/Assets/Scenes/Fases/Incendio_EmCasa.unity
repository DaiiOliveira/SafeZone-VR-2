  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SafeZoneVR.EmergencyCallPanel
  m_Root: {fileID: 389497459}
  m_OpenButton: {fileID: 1731880971}
  m_CloseButton: {fileID: 465891750}
  m_ReplyText: {fileID: 1754196457}
  m_Lines:
  - number: 199
    label: Defesa Civil
    reply: "Defesa Civil: vamos acionar os Bombeiros, mas em caso de inc\xEAndio
      ligue direto para o 193."
    button: {fileID: 485998246}
  - number: 193
    label: Bombeiros
    reply: "Corpo de Bombeiros. Endere\xE7o anotado, uma viatura est\xE1 a caminho.
      Todos sa\xEDram? N\xE3o entre na casa e mantenha as pessoas afastadas."
    button: {fileID: 1938713898}
  - number: 190
    label: "Pol\xEDcia Militar"
    reply: "Pol\xEDcia Militar: vamos repassar. Para inc\xEAndio, o n\xFAmero \xE9
      193."
    button: {fileID: 1445721815}
  - number: 192
    label: SAMU
    reply: "SAMU: se algu\xE9m estiver passando mal, estamos \xE0 disposi\xE7\xE3o.
      Para o inc\xEAndio, ligue 193."
    button: {fileID: 1971353882}
  m_AcceptedNumbers:
  - 193
  m_OnAcceptedCall:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 385422799}
        m_TargetAssemblyTypeName: SafeZoneVR.StepCompleteOnButtonPress, Assembly-CSharp
        m_MethodName: OnButtonPressed
